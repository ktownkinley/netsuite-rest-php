{
  "name": "mckinleycard/netsuite-rest-php",
  "description": "PHP client for the NetSuite REST API",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "netsuite",
    "suiteql",
    "suitetalk",
    "rest",
    "oauth2",
    "api-client"
  ],
  "homepage": "https://github.com/ktownkinley/netsuite-rest-php",
  "authors": [
    {
      "name": "McKinley Card",
      "homepage": "https://github.com/ktownkinley"
    }
  ],
  "support": {
    "issues": "https://github.com/ktownkinley/netsuite-rest-php/issues",
    "source": "https://github.com/ktownkinley/netsuite-rest-php",
    "security": "https://github.com/ktownkinley/netsuite-rest-php/security/policy"
  },
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.0",
    "web-token/jwt-library": "^3.4.10 || ^4.2"
  },
  "suggest": {
    "ext-gmp": "Fastest PS256 signing. Either ext-gmp or ext-bcmath is required at runtime to authenticate.",
    "ext-bcmath": "Fast enough PS256 signing when ext-gmp is not available. Either ext-gmp or ext-bcmath is required at runtime to authenticate."
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "NetSuiteRest\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NetSuiteRest\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  }
}
