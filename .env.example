# Copy this file to .env and fill in real NetSuite sandbox values for local integration testing.
# .env is gitignored — never commit real credentials. CI should supply these as native
# environment variables/secrets instead of a committed or synced .env file.

NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=

# Path to a PEM-encoded RSA private key file (also gitignored via *.pem). The key material
# itself is never stored directly in .env.
NETSUITE_PRIVATE_KEY_PATH=

# The account-specific NetSuite REST base URL, e.g. https://1234567-sb1.suitetalk.api.netsuite.com
NETSUITE_REST_API_BASE_URL=

# Comma-separated OAuth 2.0 scopes granted to the Integration record, e.g. rest_webservices
NETSUITE_SCOPES=rest_webservices
